{
  "name": "memoir",
  "version": "1.9.0",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "expo:start": "APP_ENV=review expo start",
    "expo:start:clear": "APP_ENV=review expo start --clear",
    "init:app:dev": "sh scripts/local/setup.sh",
    "init:app:review": "sh scripts/review/setup.sh",
    "init:app:production": "sh scripts/production/setup.sh",
    "android": "pnpm init:app:dev && pnpm expo:start --android",
    "ios": "pnpm init:app:dev && pnpm expo:start --ios",
    "ios:clear": "pnpm init:app:dev && pnpm expo:start:clear --ios",
    "dev:ios": "pnpm init:app:dev && npx expo run:ios",
    "dev:ios:device": "pnpm init:app:dev && npx expo run:ios --device",
    "dev:ios:production": "pnpm init:app:production && npx expo run:ios",
    "dev:android": "pnpm init:app:dev && npx expo run:android",
    "dev:android:device": "pnpm init:app:dev && npx expo run:android --device",
    "dev:android:production": "pnpm init:app:production && npx expo run:android",
    "android:clear": "pnpm init:app:dev && pnpm expo:start --android -c",
    "ios:build": "pnpm init:app:production && eas build --profile=production -p=ios",
    "ios:build:local": "pnpm init:app:production && eas build --profile=production -p=ios --local",
    "ios:build:dev": "pnpm init:app:production && eas build --profile=development-simulator -p=ios",
    "android:build": "pnpm init:app:production && eas build --profile=production -p=android",
    "android:build:local": "pnpm init:app:production && eas build --profile=production_apk -p=android --local",
    "android:build:dev": "pnpm init:app:production && eas build --profile=preview -p=android",
    "store:upload": "pnpm init:app:production && eas build --profile=production --platform all --non-interactive --auto-submit --no-wait",
    "format": "npx @biomejs/biome check --write ./*",
    "download:schema.graphqls": "curl -L --retry 3 --retry-delay 5 --connect-timeout 10 --max-time 30 -O https://raw.githubusercontent.com/wheatandcat/memoir-backend/main/graph/schema.graphqls",
    "codegen": "pnpm download:schema.graphqls && TZ=Asia/Tokyo graphql-codegen",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint:ci": "biome ci",
    "prepare": "if [ -d .git ] && [ \"$NODE_ENV\" != \"production\" ]; then husky install; fi",
    "unused-exports": "node ./scripts/ts-unused-exports",
    "compare-images": "reg-suit sync-expected && reg-suit compare",
    "xcode": "open ios/memoir.xcworkspace",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true npx expo run:ios",
    "storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED=true npx expo run:android",
    "storybook-generate": "sb-rn-get-stories"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@expo-google-fonts/inter": "^0.2.0",
    "@expo-google-fonts/noto-sans-jp": "^0.2.0",
    "@expo-google-fonts/roboto-condensed": "^0.2.0",
    "@expo/metro-runtime": "~56.0.20",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/metro-config": "^0.85.3",
    "@sentry/cli": "^2.43.0",
    "@sentry/react-native": "~7.11.0",
    "@types/compare-versions": "^3.3.0",
    "@types/react-native-snap-carousel": "^3.8.5",
    "@types/uuid": "^8.3.4",
    "babel-plugin-module-resolver": "^4.1.0",
    "compare-versions": "^5.0.1",
    "cross-fetch": "^4.1.0",
    "dayjs": "^1.11.5",
    "dotenv": "^16.4.7",
    "expo": "56.0.20",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.23",
    "expo-auth-session": "~56.0.17",
    "expo-blur": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.24",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.25",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.10",
    "expo-font": "~56.0.7",
    "expo-gl": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.25",
    "expo-image-picker": "~56.0.24",
    "expo-intent-launcher": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "~56.0.24",
    "expo-router": "~56.2.19",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.25",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.25",
    "expo-web-browser": "~56.0.6",
    "firebase": "^9.23.0",
    "graphql": "^16.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-app-link": "^1.0.1",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-modal-datetime-picker": "^14.0.0",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "4.3.1",
    "react-native-root-toast": "^3.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-snap-carousel": "https://github.com/LovebugLLC/react-native-snap-carousel.git",
    "react-native-switch-selector": "2.1.4",
    "react-native-view-shot": "~5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "uuid": "^9.0.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/runtime": "^7.26.7",
    "@biomejs/biome": "1.9.4",
    "@expo/config": "^56.0.13",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@graphql-codegen/cli": "^2.13.7",
    "@graphql-codegen/gql-tag-operations-preset": "^1.6.0",
    "@graphql-codegen/introspection": "^2.2.1",
    "@graphql-codegen/typed-document-node": "^2.3.4",
    "@graphql-codegen/typescript-operations": "^2.5.4",
    "@react-native-community/slider": "5.2.0",
    "@storybook/addon-ondevice-actions": "^8.6.2",
    "@storybook/addon-ondevice-controls": "^8.6.2",
    "@storybook/react-native": "^8.6.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/babel__core": "~7.1.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "@types/react-native-app-link": "^1.0.0",
    "babel-loader": "^8.2.2",
    "babel-plugin-inline-dotenv": "^1.5.0",
    "babel-preset-expo": "~56.0.19",
    "cross-env": "^7.0.3",
    "glob": "^8.1.0",
    "graphql-codegen-typescript-mock-data": "^2.2.5",
    "husky": "^8.0.1",
    "hygen": "^6.2.11",
    "identity-obj-proxy": "^3.0.0",
    "jest-expo": "~56.0.5",
    "license-checker": "^25.0.1",
    "lint-staged": "^13.0.3",
    "mockdate": "^3.0.5",
    "msw": "^2.11.3",
    "react-native-reanimated": "4.3.1",
    "react-native-svg": "15.15.4",
    "react-test-renderer": "19.2.3",
    "reg-keygen-git-hash-plugin": "^0.12.1",
    "reg-notify-github-plugin": "^0.12.1",
    "reg-publish-gcs-plugin": "^0.12.1",
    "reg-suit": "^0.12.1",
    "ts-unused-exports": "^8.0.0",
    "typescript": "~6.0.3",
    "typesync": "^0.9.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "pnpm lint"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-modal",
          "react-native-snap-carousel",
          "react-native-switch-selector",
          "@apollo/client",
          "@expo-google-fonts/inter",
          "@expo-google-fonts/noto-sans-jp",
          "@expo-google-fonts/roboto-condensed",
          "@react-native-community/masked-view",
          "compare-versions",
          "firebase",
          "graphql",
          "graphql-anywhere",
          "graphql-tag",
          "react-native-app-link",
          "uuid",
          "@graphql-typed-document-node/core",
          "cross-fetch",
          "dotenv",
          "@react-native/metro-config",
          "@sentry/cli"
        ]
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msw",
      "protobufjs"
    ]
  }
}
